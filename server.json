{
  "name": "build-vault",
  "description": "MCP server for The Build Podcast Vault - AI product discovery and insights from vault.buildaipod.com. Semantic search over thousands of insights, episodes, products and transcript segments, with OpenAI Deep Research compatibility.",
  "repository": {
    "url": "https://github.com/The-Build-Podcast/build-vault-mcp-server",
    "source": "github",
    "id": "The-Build-Podcast/build-vault-mcp-server"
  },
  "version_detail": {
    "version": "0.3.0"
  },
  "remotes": [
    {
      "transport": "streamable-http",
      "url": "https://mcp.buildaipod.com/mcp",
      "description": "Production endpoint (global edge). Legacy SSE at /sse.",
      "features": {
        "tools": 18,
        "resources": 4,
        "prompts": 4,
        "semantic_search": true,
        "deep_research": true
      }
    },
    {
      "transport": "streamable-http",
      "url": "https://mcp.demos.build/mcp",
      "description": "Alternative production endpoint. Legacy SSE at /sse.",
      "features": {
        "tools": 18,
        "resources": 4,
        "prompts": 4,
        "semantic_search": true,
        "deep_research": true
      }
    }
  ],
  "packages": [
    {
      "registry_name": "npm",
      "name": "build-vault-mcp-server",
      "environment_variables": [
        {
          "name": "VAULT_API_BASE_URL",
          "description": "Base URL of the Build Vault backend API, used by the local stdio transport. Not needed when connecting to the hosted remote endpoints.",
          "is_required": false,
          "is_secret": false
        }
      ],
      "package_arguments": []
    }
  ],
  "supported_clients": [
    "claude_desktop",
    "claude_code",
    "goose",
    "openai_chatgpt"
  ],
  "features": {
    "protocol_version": "2025-11-25",
    "transports": ["stdio", "streamable-http", "sse"],
    "capabilities": {
      "tools": {
        "count": 18,
        "categories": ["search", "analytics", "discovery", "catalog", "deep_research"]
      },
      "resources": {
        "count": 4
      },
      "prompts": {
        "count": 4,
        "guided_workflows": true
      }
    },
    "data_source": {
      "semantic_search": true,
      "categories": ["frameworks", "points_of_view", "business_ideas", "stories", "quotes", "products"]
    }
  },
  "tags": [
    "ai",
    "podcast",
    "insights",
    "semantic-search",
    "vector-database",
    "openai-deep-research",
    "chatgpt-connector",
    "build-podcast"
  ]
}
